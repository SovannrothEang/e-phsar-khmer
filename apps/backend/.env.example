# Runtime mode: `production` enables the fail-closed CORS check (an empty
# FRONTEND_ORIGINS refuses boot) and disables the Swagger UI.
NODE_ENV=development
# Comma-separated browser origins allowed by CORS and the chat WebSocket.
# Required in production. In development an empty list allows any origin for
# CORS, but browser sockets are still rejected without an entry — keep the
# local web origin here.
FRONTEND_ORIGINS=http://localhost:3001

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=
# Which shape this process runs: api | worker | all (default all).
#   api    - HTTP only; no BullMQ worker, no outbox drainer, no sweeper
#   worker - runs those (and still answers health checks)
#   all    - both, the single-process shape used by local dev
# Set this as a real environment variable on the host, not only here: the
# module graph reads it before .env is loaded (see src/config/runtime-role.ts).
APP_ROLE=all
# Max postgres.js pool connections, shared by the whole backend.
# Default follows APP_ROLE: api 5, worker 15, all 20. Never above 20.
DATABASE_POOL_MAX=
# Connection lifecycle, in seconds.
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=60
DATABASE_MAX_LIFETIME_SECONDS=1800
# Statement/lock timeouts are Postgres startup parameters; Supabase's
# transaction-mode pooler rejects startup parameters it does not know, so they
# stay off (0) unless you connect directly. Milliseconds.
DATABASE_STATEMENT_TIMEOUT_MS=0
DATABASE_LOCK_TIMEOUT_MS=0

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

QUEUE_HOST=localhost
QUEUE_PORT=6379
QUEUE_PASSWORD=
QUEUE_DB=0
QUEUE_PREFIX=phsar

# Payment job retry policy (BullMQ side)
PAYMENT_JOB_ATTEMPTS=3
PAYMENT_JOB_BACKOFF_MS=5000
PAYMENT_WORKER_CONCURRENCY=5
# Providers the payment reconciler asks about (default: bakong,aba_payway).
# ABA is webhook-only, but it is polled too so a lost/delayed callback is still
# recovered — that costs one check_transaction call per unresolved ABA attempt
# per pass.
PAYMENT_RECONCILE_PROVIDERS=bakong,aba_payway
# Shared secret (min 16 chars) for POST /api/v1/internal/payments/reconcile,
# the wake-up an external pinger/cron calls when nobody is on a checkout page.
# Leave empty to disable the route (it answers 503). Never call it from a
# browser.
INTERNAL_RECONCILE_SECRET=

# ABA PayWay gateway
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Publicly reachable — this is the `return_url` ABA is told to POST payment
# results to on every purchase call, i.e. this backend's own
# /api/v1/payments/webhooks/aba-payway route, not a browser redirect. Required:
# ABA is webhook-only, so without it ABA is unavailable at checkout.
ABA_PAYWAY_WEBHOOK_URL=
# Minutes a checkout stays payable (min 3). ABA rejects payment after it;
# ABA's own default would be 30 days.
ABA_PAYWAY_LIFETIME_MINUTES=15

# Bakong KHQR. Unlike ABA, there is no create-transaction network call — the
# fields below feed the bakong-khqr SDK's local, offline KHQR generation;
# BAKONG_API_KEY (a bearer token from Bakong's developer portal) is only
# used to poll check_transaction_by_md5 for the payment outcome.
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_KEY=
# 'individual' needs only ACCOUNT_ID + MERCHANT_NAME (a personal Bakong
# account alias, e.g. "yourname@bank" — no business registration required).
# 'merchant' additionally needs MERCHANT_ID + ACQUIRING_BANK, issued by a
# participating bank/PSP through merchant onboarding.
BAKONG_MERCHANT_TYPE=individual
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=Phnom Penh
# Only needed when BAKONG_MERCHANT_TYPE=merchant.
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
BAKONG_QR_EXPIRY_SECONDS=300
# Bakong delivers no webhooks — this is the delay between poll-attempt jobs
# re-checking check_transaction_by_md5 (see
# src/payment/providers/bakong/README.md).
BAKONG_POLL_INTERVAL_MS=4000

# SMS notifications (PlasGate provider)
SMS_PRIVATE_KEY=<private key from the PlasGate dashboard>
SMS_SECRET=<secret key from the PlasGate dashboard>
SMS_SENDER=<your approved sender name>
# Optional; defaults to the PlasGate cloud endpoint.
SMS_BASE_URL=https://cloudapi.plasgate.com/rest/send
# Per-user spam limits (optional, defaults shown): shared by notification SMS
# and the phone-OTP flows.
SMS_RATE_LIMIT_PER_MINUTE=150
SMS_USER_COOLDOWN_SECONDS=300
SMS_USER_DAILY_CAP=10

# Phone OTP — which backend issues and verifies codes. `plasgate` is the shipped
# DEFAULT and enables the own OTP service plus the forgot-password endpoints;
# `supabase` keeps the old behaviour (those endpoints then answer 503
# OTP_PROVIDER_UNSUPPORTED). Production refuses to boot on `plasgate` unless
# SMS_PRIVATE_KEY, SMS_SECRET and SMS_SENDER are all set, because no code can
# be delivered without them.
# Sample matches the shipped DEFAULT.
OTP_PROVIDER=plasgate
# REQUIRED on the plasgate path (min 16 chars): generate one per environment,
# e.g. `openssl rand -hex 32`. Rotating it invalidates every unexpired code.
# Left empty on purpose: a copied example fails config validation loudly
# instead of silently hashing codes with a placeholder.
OTP_HMAC_SECRET=
