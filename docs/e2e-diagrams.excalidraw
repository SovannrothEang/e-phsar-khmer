      "updated": 1790306668573,
      "link": null,
      "locked": false,
      "text": "What A3 can read:\n• messages sent AFTER it joined\n   → its own envelope ✓\n• messages sent BEFORE\n   → from the backup ✓",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b3",
      "originalText": "What A3 can read:\n• messages sent AFTER it joined\n   → its own envelope ✓\n• messages sent BEFORE\n   → from the backup ✓",
      "autoResize": true,
      "lineHeight": 1.25
    },
