    {
      "id": "legend",
      "type": "text",
      "x": 0,
      "y": 1690,
      "width": 978.265625,
      "height": 36.8,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "b0F",
      "isDeleted": false,
      "lineHeight": 1.15,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Purple dashed: A1 taps \"Allow\" → sends BK (32 bytes) to A3 over their E2E device-to-device session, relayed via e2e_history_requests.\nThe server never sees BK, the passcode, or any plaintext — private keys and decrypted messages live only in each browser (IndexedDB).",
      "roughness": 1,
      "roundness": null,
      "seed": 1841270907,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Purple dashed: A1 taps \"Allow\" → sends BK (32 bytes) to A3 over their E2E device-to-device session, relayed via e2e_history_requests.\nThe server never sees BK, the passcode, or any plaintext — private keys and decrypted messages live only in each browser (IndexedDB).",
      "textAlign": "left",
      "updated": 1790306607851,
      "version": 1,
      "versionNonce": 1777162395,
      "verticalAlign": "top"
    },
